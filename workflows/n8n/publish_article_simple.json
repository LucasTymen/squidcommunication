{
  "name": "Publish Article to Social Media (Simple)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-article",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "publish-article-simple"
    },
    {
      "parameters": {
        "command": "cd /home/lucas/tools/squidCommunication/articles/{{ $json.article_slug }}/platforms/{{ $json.platform }} && cat post-01.md"
      },
      "id": "read-content",
      "name": "Read Post File",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "post-text",
              "name": "post_text",
              "value": "={{ $json.stdout.split('## Contenu')[1]?.split('---')[0]?.trim() || $json.stdout }}",
              "type": "string"
            },
            {
              "id": "article-slug",
              "name": "article_slug",
              "value": "={{ $('Webhook').item.json.article_slug }}",
              "type": "string"
            },
            {
              "id": "platform",
              "name": "platform",
              "value": "={{ $('Webhook').item.json.platform }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-text",
      "name": "Extract Post Text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 300]
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "create",
        "text": "={{ $json.post_text }}",
        "options": {}
      },
      "id": "linkedin-post",
      "name": "LinkedIn Post",
      "type": "@n8n/n8n-nodes-langchain.linkedIn",
      "typeVersion": 1,
      "position": [900, 200],
      "disabled": true,
      "notes": "Configurer credential LinkedIn OAuth2 avant d'activer"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"article_slug\": $json.article_slug, \"platform\": $json.platform, \"published_at\": new Date().toISOString() } }}",
        "options": {}
      },
      "id": "webhook-response",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Read Post File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Post File": {
      "main": [
        [
          {
            "node": "Extract Post Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Post Text": {
      "main": [
        [
          {
            "node": "LinkedIn Post",
            "type": "main",
            "index": 0
          },
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "LinkedIn Post": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
