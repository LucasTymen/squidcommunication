{
  "name": "Publish Article to Social Media",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-article",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "publish-article-social"
    },
    {
      "parameters": {
        "jsCode": "// Valider les paramètres d'entrée\nconst articleSlug = $input.item.json.article_slug;\nconst platform = $input.item.json.platform || 'linkedin';\n\nif (!articleSlug) {\n  throw new Error('article_slug est requis');\n}\n\nreturn {\n  json: {\n    article_slug: articleSlug,\n    platform: platform,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "command": "cd /home/lucas/tools/squidCommunication && cat articles/{{ $json.article_slug }}/platforms/{{ $json.platform }}/post-01.md"
      },
      "id": "read-post-content",
      "name": "Read Post Content",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parser le contenu Markdown pour extraire le texte du post\nconst content = $input.item.json.stdout;\n\n// Extraire la section Contenu (entre ## Contenu et ---)\nconst contentMatch = content.match(/## Contenu\\n\\n([\\s\\S]*?)\\n\\n---/);\nconst postText = contentMatch ? contentMatch[1].trim() : content;\n\n// Extraire les hashtags si présents\nconst hashtagMatch = postText.match(/(#[\\w]+(?:\\s+#[\\w]+)*)/);\nconst hashtags = hashtagMatch ? hashtagMatch[1] : '';\n\nreturn {\n  json: {\n    ...$('Validate Input').item.json,\n    post_text: postText,\n    hashtags: hashtags,\n    raw_content: content\n  }\n};"
      },
      "id": "parse-content",
      "name": "Parse Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.platform }}",
              "operation": "equals",
              "value2": "linkedin"
            }
          ]
        }
      },
      "id": "check-platform-linkedin",
      "name": "Check Platform: LinkedIn",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "create",
        "text": "={{ $json.post_text }}",
        "additionalFields": {}
      },
      "id": "post-linkedin",
